        "text": "\"That is a good joke,\" said the Hare; \"I could dance round you all the way.\"",
        "start_ms": 15337,
        "end_ms": 19104,
        "confidence": 1.0,
        "block_xpath": "/*/*[2]/*/*[3]",
        "char_start": 54,
        "char_end": 130
      },
